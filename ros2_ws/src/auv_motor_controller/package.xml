<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_motor_controller</name>
  <version>0.1.0</version>
  <description>
    Pi-side ROS2 bridge for the Teensy 4.0 motor controller.
    Implements the thruster allocation matrix (TAM) to convert
    wrench commands into per-thruster PWM values.
  </description>
  <maintainer email="jnlamoureux@gmail.com">AUV Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>auv_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
