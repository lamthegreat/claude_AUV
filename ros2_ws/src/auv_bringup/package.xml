<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level launch files and system configuration for the AUV.
    auv_full.launch.py brings up all nodes. auv_hardware.launch.py
    brings up only hardware-facing nodes (no autonomy stack).
  </description>
  <maintainer email="jnlamoureux@gmail.com">AUV Developer</maintainer>
  <license>MIT</license>

  <exec_depend>auv_msgs</exec_depend>
  <exec_depend>auv_sensor_hub</exec_depend>
  <exec_depend>auv_motor_controller</exec_depend>
  <exec_depend>auv_state_estimator</exec_depend>
  <exec_depend>auv_controller</exec_depend>
  <exec_depend>auv_navigation</exec_depend>
  <exec_depend>auv_safety</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
