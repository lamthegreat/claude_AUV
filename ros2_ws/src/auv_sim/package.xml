<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_sim</name>
  <version>0.1.0</version>
  <description>
    Lightweight simulation helpers and smoke-test scenarios for validating
    the AUV ROS 2 stack without hardware.
  </description>
  <maintainer email="jnlamoureux@gmail.com">AUV Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>auv_msgs</depend>
  <exec_depend>auv_motor_controller</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
